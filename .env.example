# Enter the base URL and API key for each application you use.
# URLs must be reachable FROM THE HOMELABPILOT CONTAINER.
RADARR_URL=
RADARR_API_KEY=

SONARR_URL=
SONARR_API_KEY=

PROWLARR_URL=
PROWLARR_API_KEY=

BAZARR_URL=
BAZARR_API_KEY=

LIDARR_URL=
LIDARR_API_KEY=

# Scryer GraphQL endpoint base URL (the server appends /graphql)
SCRYER_URL=
SCRYER_API_KEY=

# qBittorrent WebUI
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

HTTP_TIMEOUT=15

# Gemini CLI agent (optional; keep the real key only in your local .env)
GEMINI_API_KEY=

# Browser dashboard login (separate from the MCP bearer token)
HOMELABPILOT_WEB_USERNAME=admin
HOMELABPILOT_WEB_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# Authenticated remote MCP transport (generate with: openssl rand -hex 32)
MCP_TRANSPORT=streamable-http
MCP_AUTH_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Stable key for encrypted dashboard app settings (generate with: openssl rand -hex 32).
# Keep this value unchanged; if empty, MCP_AUTH_TOKEN is used as the encryption key source.
HOMELABPILOT_CONFIG_ENCRYPTION_KEY=

# MCP tool permissions: read, operations (default) or admin
HOMELABPILOT_MCP_PERMISSION_LEVEL=operations
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Host header patterns accepted by the MCP HTTP transport, comma-separated.
# Add the address and published port used by your MCP client, e.g. 192.168.1.61:8765.
HOMELABPILOT_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*

# Host interface for the web dashboard and MCP endpoint. Use 0.0.0.0 for LAN access.
# Keep router port-forwarding disabled; use a private VPN for remote access.
HOMELABPILOT_BIND_ADDRESS=127.0.0.1
HOMELABPILOT_PORT=8765

# Persisted metadata-only operation audit (Compose mounts the named volume at /data).
HOMELABPILOT_AUDIT_DB_PATH=/data/operation-history.sqlite3

# Optional Docker controls. Disabled by default. Only exact names/IDs in the
# allowlist can be listed or started/stopped/restarted; no exec/remove/create.
# Enable the Compose profile with: docker compose --profile docker up -d --build
HOMELABPILOT_DOCKER_ENABLED=false
HOMELABPILOT_DOCKER_PERMISSION_LEVEL=read
HOMELABPILOT_DOCKER_GATEWAY_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
HOMELABPILOT_DOCKER_ALLOWED_CONTAINERS=radarr,sonarr,prowlarr,bazarr,lidarr,qbittorrent


# Additional HTTP integrations (optional; configure only the apps you run).
PLEX_URL=
PLEX_TOKEN=
JELLYFIN_URL=
JELLYFIN_API_KEY=
SEERR_URL=
SEERR_API_KEY=
TRANSMISSION_URL=
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=
PULSARR_URL=
PULSARR_API_KEY=
CLEANUPARR_URL=
CLEANUPARR_API_KEY=
MAINTAINERR_URL=
AGREGARR_URL=
AGREGARR_API_KEY=
TRACEARR_URL=
TRACEARR_API_KEY=
IMMICH_URL=
IMMICH_API_KEY=
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
ROMM_URL=
ROMM_API_TOKEN=
BOOKORBIT_URL=
BOOKORBIT_API_KEY=
TINYMEDIAMANAGER_URL=
TINYMEDIAMANAGER_API_KEY=
TIDARR_URL=
TIDARR_API_KEY=
TDARR_URL=
TDARR_API_KEY=
FLARESOLVERR_URL=
YOUTARR_URL=
YOUTARR_API_KEY=
CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_API_TOKEN=

# Non-HTTP integration connectivity and container/CLI visibility.
POSTGRES_HOST=
POSTGRES_PORT=5432
REDIS_HOST=
REDIS_PORT=6379
RECYCLARR_CONTAINER=
