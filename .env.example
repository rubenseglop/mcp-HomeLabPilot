# Enter the base URL and API key for each application you use.
# URLs must be reachable FROM THE STACKARR CONTAINER.
RADARR_URL=
RADARR_API_KEY=

SONARR_URL=
SONARR_API_KEY=

PROWLARR_URL=
PROWLARR_API_KEY=

BAZARR_URL=
BAZARR_API_KEY=

# Scryer GraphQL endpoint base URL (the server appends /graphql)
SCRYER_URL=
SCRYER_API_KEY=

# qBittorrent WebUI
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

HTTP_TIMEOUT=15

# Authenticated remote MCP transport (generate with: openssl rand -hex 32)
MCP_TRANSPORT=streamable-http
MCP_AUTH_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Port published on 127.0.0.1 of the Docker host
STACKARR_PORT=8765
