# Radarr / Sonarr / Prowlarr / Bazarr base URLs and API keys
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

BAZARR_URL=http://bazarr:6767
BAZARR_API_KEY=

# Scryer GraphQL endpoint base URL (the server appends /graphql)
SCRYER_URL=http://scryer:8080
SCRYER_API_KEY=

# qBittorrent WebUI
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

HTTP_TIMEOUT=15

# Authenticated remote MCP transport (generate with: openssl rand -hex 32)
MCP_TRANSPORT=streamable-http
MCP_AUTH_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Port published on 127.0.0.1 of the Docker host
STACKARR_PORT=8765
# Existing Docker network shared with Radarr/Sonarr/Scryer/qBittorrent
STACKARR_DOCKER_NETWORK=downloads_default
