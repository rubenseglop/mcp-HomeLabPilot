FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    HOME=/home/node \
    CODEX_HOME=/home/node/.codex \
    AGENT_STATE_DIR=/state \
    AGENT_GATEWAY_PORT=8766

RUN npm install --global @openai/codex \
    && mkdir -p /app /state /workspace /home/node/.codex \
    && chown -R node:node /app /state /workspace /home/node/.codex

WORKDIR /app
COPY --chown=node:node agent-gateway.mjs ./agent-gateway.mjs
USER node

EXPOSE 8766
CMD ["node", "/app/agent-gateway.mjs"]
