FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    HOME=/home/node \
    CODEX_HOME=/home/node/.codex \
    CLAUDE_CONFIG_DIR=/home/node/.claude \
    AGENT_STATE_DIR=/state \
    AGENT_GATEWAY_PORT=8766

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global @openai/codex @anthropic-ai/claude-code @google/gemini-cli@0.69.0 \
    && mkdir -p /app /state /workspace /home/node/.codex /home/node/.claude /home/node/.gemini \
    && chown -R node:node /app /state /workspace /home/node/.codex /home/node/.claude /home/node/.gemini

RUN printf "\\nprecedence ::ffff:0:0/96 100\\n" >> /etc/gai.conf

WORKDIR /app
COPY --chown=node:node agent-gateway.mjs ./agent-gateway.mjs
USER node

EXPOSE 8766
CMD ["node", "/app/agent-gateway.mjs"]
